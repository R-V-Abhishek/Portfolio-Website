---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/design/PageIntro.astro";
import SectionHeading from "../components/design/SectionHeading.astro";
import ProjectCard from "../components/design/ProjectCard.astro";
import Filter from "../components/design/Filter.astro";
import Connection from "../components/design/Connection.astro";
import { projects, topics, collectionNames } from "../data/projects";
---

<BaseLayout title="Work & explorations | R V Abhishek">
  <PageIntro
    label="A collection of things I’ve built"
    title="Work & explorations."
    description="Some begin with a practical problem. Others begin with a question that won’t quite go away. Here’s where those threads have led."
  >
    <nav class="collection-nav" aria-label="Project collections">
      {Object.entries(collectionNames).map(([key, name]) => (
        <a
          href={`#${key === "ai" ? "ai" : key === "passion" ? "passion" : "coursework"}`}
        >
          {name}
          <span>
            {String(
              projects.filter((p) => p.collection === key).length,
            ).padStart(2, "0")}
          </span>
        </a>
      ))}
    </nav>
  </PageIntro>
  <section class="section" id="ai">
    <div class="container" data-filter-root>
      <SectionHeading
        number="01"
        label="Models, signals & systems"
        title="AI & ML"
      />
      <Filter topics={topics} label="Filter AI and ML projects by topic" />
      <div class="filter-grid">
        {projects
          .filter((p) => p.collection === "ai")
          .map((p, i) => (
            <ProjectCard project={p} featured={i === 0} compact={i > 2} />
          ))}
      </div>
    </div>
  </section>
  <section class="section" id="passion">
    <div class="container">
      <SectionHeading
        number="02"
        label="Built out of personal interest"
        title="Passion Projects"
      />
      <div class="grid-three">
        {projects
          .filter((p) => p.collection === "passion")
          .map((p) => (
            <ProjectCard project={p} />
          ))}
      </div>
    </div>
  </section>
  <section class="section" id="coursework">
    <div class="container">
      <SectionHeading
        number="03"
        label="Learning by doing"
        title="Coursework & Explorations"
      />
      {projects
        .filter((p) => p.collection === "coursework")
        .map((p, i) => (
          <article class="ledger-row">
            <span class="mono">0{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <div class="tags">
                {p.topics.map((t) => (
                  <span>{t}</span>
                ))}
              </div>
            </div>
            <p>{p.summary}</p>
            <a class="text-link" href={p.repository}>
              Repository ↗
            </a>
          </article>
        ))}
    </div>
  </section>
  <Connection />
</BaseLayout>
