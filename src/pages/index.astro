---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Diagram from "../components/design/Diagram.astro";
import SectionHeading from "../components/design/SectionHeading.astro";
import ProjectCard from "../components/design/ProjectCard.astro";
import Connection from "../components/design/Connection.astro";
import { projects } from "../data/projects";
import { pillars } from "../data/experience";
import { url } from "../data/config";
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);
---

<BaseLayout>
  <section class="hero">
    <div class="container split">
      <div>
        <p class="eyebrow">R V Abhishek / Bengaluru / AI & useful software</p>
        <h1>
          Finding <em>patterns.</em>
          <br />
          Building things.
        </h1>
        <p class="lede">
          I work where machine learning meets the real world: computer vision,
          language, and the systems that make them useful. Outside the code, I’m
          a Carnatic vocalist, listening for patterns of a different kind.
        </p>
        <div class="actions">
          <a class="button primary" href={url("projects/")}>
            Explore my work <span>↗</span>
          </a>
          <a class="button" href={url("about/")}>
            About me <span>→</span>
          </a>
        </div>
        <p class="hero-note mono">
          Data Science Intern at Amagi · CSE & Data Science, BMSCE
        </p>
      </div>
      <div class="hero-figure">
        <Diagram label="A conceptual study in signals, observations, and connections." />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading
        number="01"
        label="Code meets curiosity"
        title="Selected AI & ML work"
        href={url("projects/")}
        action="The full collection →"
      />
      <ProjectCard
        project={projects.find((p) => p.homePlacement === "featured")!}
        featured
      />
      <div class="grid-two">
        {projects
          .filter((p) => p.homePlacement === "selected")
          .map((p) => (
            <ProjectCard project={p} />
          ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading number="02" label="Industry practice" title="At Amagi" />
      <div class="split">
        <div class="intro-copy">
          <h2>
            Applied intelligence.
            <br />
            <em>Real-world constraints.</em>
          </h2>
          <p>
            My work at Amagi connects model development with the practical
            details around it: dataset coverage, broadcast overlays, AI
            evaluation, and media previews.
          </p>
          <p>
            I’m interested in the whole loop — understanding a failure,
            improving the right part of the system, and checking what actually
            changed.
          </p>
          <a class="text-link" href={url("experience/amagi/")}>
            Explore my Amagi experience →
          </a>
        </div>
        <div class="pillars">
          {pillars.map((p, i) => (
            <div class="pillar">
              <span class="mono">
                0{i + 1} / {p.anchor.toUpperCase()}
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading
        number="03"
        label="Experiments & interests"
        title="Passion Projects"
        href={url("projects/#passion")}
        action="More experiments →"
      />
      <div class="grid-three">
        {projects
          .filter((p) => p.collection === "passion")
          .map((p) => (
            <ProjectCard project={p} />
          ))}
      </div>
    </div>
  </section>
  <section class="section recognition">
    <div class="container">
      <SectionHeading
        number="04"
        label="Milestones along the way"
        title="Recognition"
        href={url("skills/")}
        action="Skills & Credentials →"
      />
      <div class="ledger-row">
        <span class="mono">01</span>
        <div>
          <h3>NPTEL · Elite, Top 1%</h3>
          <p>NPTEL coursework</p>
        </div>
        <p>A foundation in understanding the models behind the interface.</p>
      </div>
      <div class="ledger-row">
        <span class="mono">02</span>
        <div>
          <h3>Unisys Innovation Program</h3>
          <p>Top 6 National Finalist · SwaraSync</p>
        </div>
        <p>
          Bringing Carnatic music and computational thinking into the same
          conversation.
        </p>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="container split">
      <Diagram
        kind="music"
        label="A conceptual sketch of pitch, rhythm, and recurring structure."
      />
      <div class="intro-copy">
        <p class="eyebrow">05 / Beyond the models</p>
        <h2>
          A musician’s ear.
          <br />
          An engineer’s curiosity.
        </h2>
        <p>
          Music was my first way of exploring patterns. After 75+ concerts
          across Karnataka and Tamil Nadu, I’m still fascinated by how a simple
          structure leaves room for so much expression.
        </p>
        <p class="quote">
          “Both ask you to listen carefully before you try to explain.”
        </p>
        <a class="text-link" href={url("about/#music")}>
          Beyond the work →
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading
        number="06"
        label="Ideas in the open"
        title="Recent writing"
        href={url("blog/")}
        action="All writing →"
      />
      {posts.map((post) => (
        <article class="writing-row">
          <time class="mono" datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString("en-GB", {
              month: "short",
              year: "numeric",
            })}
          </time>
          <div>
            <h3>
              <a href={url(`blog/${post.slug}/`)}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
          </div>
          <a
            href={url(`blog/${post.slug}/`)}
            aria-label={`Read ${post.data.title}`}
          >
            ↗
          </a>
        </article>
      ))}
    </div>
  </section>
  <Connection />
</BaseLayout>
