---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/design/PageIntro.astro";
import Filter from "../../components/design/Filter.astro";
import { url } from "../../data/config";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const tags = ["All", ...new Set(posts.flatMap((p) => p.data.tags))];
const feature = posts.find((p) => p.data.featured) || posts[0];
const ordered = feature
  ? [feature, ...posts.filter((p) => p.slug !== feature.slug)]
  : posts;
---

<BaseLayout title="Writing & notes | R V Abhishek">
  <PageIntro
    label="Thinking out loud"
    title="Writing & notes."
    description="Observations from building, learning, and following a question a little further."
  >
    <div class="actions">
      <a class="text-link" href={url("rss.xml")}>
        Subscribe via RSS ↗
      </a>
    </div>
  </PageIntro>
  <section class="section">
    <div class="container" data-filter-root data-filter-noun="article">
      <Filter topics={tags} label="Filter writing by tag" noun="articles" />
      {ordered.map((post, i) => (
        <article
          class:list={["writing-row", { "featured-writing": i === 0 }]}
          data-filter-item
          data-topics={JSON.stringify(post.data.tags)}
        >
          <time class="mono" datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "short",
              year: "numeric",
            })}
            <br />
            {Math.max(
              1,
              Math.ceil(post.body.trim().split(/\s+/).length / 200),
            )}{" "}
            min read
          </time>
          <div>
            {i === 0 && <p class="eyebrow">Featured note</p>}
            <h2>
              <a href={url(`blog/${post.slug}/`)}>{post.data.title}</a>
            </h2>
            <p style="margin-top:20px">{post.data.description}</p>
            <div class="tags">
              {post.data.tags.map((t) => (
                <span>{t}</span>
              ))}
            </div>
            <a
              class="text-link"
              style="margin-top:22px"
              href={url(`blog/${post.slug}/`)}
            >
              Read article →
            </a>
          </div>
          <span aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
<style>
  .featured-writing {
    padding: 40px;
    background: var(--secondary);
    border: 1px solid var(--line);
    margin-bottom: 30px;
  }
  .writing-row h2 {
    font-size: 32px;
  }
  .featured-writing h2 {
    font-size: 40px;
  }
  @media (max-width: 700px) {
    .featured-writing {
      padding: 24px;
    }
    .writing-row h2,
    .featured-writing h2 {
      font-size: 29px;
    }
  }
</style>
