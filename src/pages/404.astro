---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../data/config";
---

<BaseLayout title="Page not found | R V Abhishek">
  <section class="not-found container">
    <p class="eyebrow">An unexpected detour</p>
    <h1>404</h1>
    <h2>This path doesn’t lead anywhere.</h2>
    <p>There are still plenty of interesting directions to explore.</p>
    <svg
      class="broken-path"
      viewBox="0 0 220 80"
      role="img"
      aria-label="A path with a small gap"
    >
      <path
        d="M10 60H65V20H100M125 20H160V60H210"
        stroke="currentColor"
        fill="none"
        stroke-width="2"
        stroke-dasharray="5 4"
      />
      <circle cx="10" cy="60" r="4" fill="currentColor" />
      <circle cx="210" cy="60" r="4" fill="currentColor" />
    </svg>
    <div class="actions">
      <a class="button primary" href={url()}>
        Go home →
      </a>
      <a class="button" href={url("projects/")}>
        Explore the work ↗
      </a>
    </div>
  </section>
</BaseLayout>
