---
import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { url } from "../data/config";
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingTime: number;
  headings?: MarkdownHeading[];
}
const {
  title,
  description,
  publishDate,
  updatedDate,
  tags,
  readingTime,
  headings = [],
} = Astro.props;
const related = (
  await getCollection("blog", ({ data }) => !data.draft && data.title !== title)
).slice(0, 2);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout title={`${title} | R V Abhishek`} description={description}>
  <article>
    <header class="article-header reading">
      <a class="text-link" href={url("blog/")}>
        ← Writing & notes
      </a>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="article-meta mono">
        <time datetime={publishDate.toISOString()}>{fmt(publishDate)}</time>
        {updatedDate && <span> · Updated {fmt(updatedDate)}</span>} ·{" "}
        {readingTime} min read
      </div>
      <div class="tags">
        {tags.map((t) => (
          <span>{t}</span>
        ))}
      </div>
    </header>
    <div class="article-body">
      <div class="reading">
        {headings.length > 3 && (
          <details class="article-contents">
            <summary>On this page</summary>
            <ul>
              {headings
                .filter((h) => h.depth === 2)
                .map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
            </ul>
          </details>
        )}
        <div class="prose">
          <slot />
        </div>
        <div class="article-related">
          <p class="eyebrow">Keep reading</p>
          {related.map((p) => (
            <p>
              <a href={url(`blog/${p.slug}/`)}>{p.data.title} →</a>
            </p>
          ))}
          <div class="actions">
            <a class="button" href={url("blog/")}>
              ← All writing
            </a>
            <a class="button primary" href={url("contact/")}>
              Discuss this note ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
