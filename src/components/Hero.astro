---
---

<section id="hero" class="hero">
	<div class="hero-container hoverable-card fade-in" style="--flood-color: var(--primary-color);">
		<div class="hero-content">
			<h1 class="hero-title">
				<span class="title-line">Hi, I'm</span>
				<span class="name-highlight">R V Abhishek</span>
			</h1>
			<p class="hero-role">
				<span class="role-primary">Full-Stack Developer</span>
				<span class="role-divider">|</span>
				<span class="role-secondary">Data Science & AI/ML Enthusiast</span>
			</p>
			<p class="hero-description">
				Building innovative solutions at BMS College of Engineering. 
				Passionate about creating seamless digital experiences and exploring the frontiers of artificial intelligence.
			</p>
			<div class="hero-badges">
				<span class="badge badge-primary">🎓 B.Tech CSE</span>
				<span class="badge badge-secondary">💻 9.67 CGPA</span>
				<span class="badge badge-accent">✨ Available for opportunities</span>
			</div>
			<div class="cta-buttons">
				<a href="#projects" class="btn btn-primary">View Projects</a>
				<a href="#contact" class="btn btn-secondary">Get In Touch</a>
			</div>
			<div class="social-links">
				<a href="https://github.com/R-V-Abhishek" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub" class="social-link">
					<span class="link-icon">💻</span>
					<span class="link-text">GitHub</span>
				</a>
				<a href="https://www.linkedin.com/in/r-v-abhishek" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" class="social-link">
					<span class="link-icon">💼</span>
					<span class="link-text">LinkedIn</span>
				</a>
				<a href="mailto:rvabhi2504@gmail.com" aria-label="Email" title="Email" class="social-link">
					<span class="link-icon">📧</span>
					<span class="link-text">Email</span>
				</a>
			</div>
		</div>
	</div>
	<div class="scroll-indicator">
		<span>Scroll to explore ↓</span>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 6rem 2rem 4rem;
		background: radial-gradient(ellipse at center, rgba(var(--primary-rgb), 0.14) 0%, var(--bg-color) 70%);
		position: relative;
		overflow: hidden;
	}

	.hero-container {
		max-width: 900px;
		width: 100%;
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 24px;
		box-shadow: 
			0 0 40px rgba(var(--secondary-rgb), 0.3),
			0 30px 80px rgba(0, 0, 0, 0.9),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--secondary-rgb), 0.3);
		overflow: hidden;
		animation: hero-entrance 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		position: relative;
		transform-style: preserve-3d;
		will-change: transform;
	}

	.hero-container::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, var(--secondary-color), transparent 70%);
		opacity: 0;
		transform: translate(-50%, -50%);
		transition: opacity 0.6s ease;
		pointer-events: none;
	}

	.hero-container:hover::after {
		opacity: 0.15;
	}

	@keyframes hero-entrance {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-content {
		padding: 3rem 2.5rem;
		text-align: center;
		font-family: system-ui, -apple-system, sans-serif;
	}

	.hero-title {
		margin: 0 0 1.5rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.title-line {
		font-size: 1.5rem;
		color: var(--text-muted);
		font-weight: 400;
	}

	.name-highlight {
		font-size: 3.5rem;
		font-weight: 700;
		background: linear-gradient(135deg, var(--primary-color), var(--secondary-color), var(--accent-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		background-size: 200% auto;
		animation: gradient-flow 3s ease infinite;
		text-shadow: 0 0 20px rgba(var(--primary-rgb), 0.5);
	}

	@keyframes gradient-flow {
		0%, 100% { background-position: 0% center; }
		50% { background-position: 100% center; }
	}

	.hero-role {
		font-size: 1.3rem;
		margin: 0 0 1.5rem 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
	}

	.role-primary {
		color: var(--secondary-color);
		font-weight: 600;
	}

	.role-divider {
		color: var(--text-muted);
	}

	.role-secondary {
		color: var(--accent-color);
		font-weight: 500;
	}

	.hero-description {
		font-size: 1.1rem;
		color: var(--text-color);
		line-height: 1.7;
		margin: 0 0 2rem 0;
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.badge {
		padding: 0.5rem 1rem;
		border-radius: 20px;
		font-size: 0.9rem;
		font-weight: 600;
		transition: all 0.3s ease;
	}

	.badge-primary {
		background: rgba(var(--primary-rgb), 0.15);
		border: 2px solid rgba(var(--primary-rgb), 0.4);
		color: var(--primary-color);
	}

	.badge-primary:hover {
		background: rgba(var(--primary-rgb), 0.25);
		box-shadow: 0 0 20px rgba(var(--primary-rgb), 0.4);
	}

	.badge-secondary {
		background: rgba(var(--secondary-rgb), 0.15);
		border: 2px solid rgba(var(--secondary-rgb), 0.4);
		color: var(--secondary-color);
	}

	.badge-secondary:hover {
		background: rgba(var(--secondary-rgb), 0.25);
		box-shadow: 0 0 20px rgba(var(--secondary-rgb), 0.4);
	}

	.badge-accent {
		background: rgba(var(--accent-rgb), 0.15);
		border: 2px solid rgba(var(--accent-rgb), 0.4);
		color: var(--accent-color);
	}

	.badge-accent:hover {
		background: rgba(var(--accent-rgb), 0.25);
		box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.4);
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.cta-buttons .btn {
		min-width: 180px;
	}

	.social-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.25rem;
		background: color-mix(in srgb, var(--card-bg) 90%, var(--bg-color) 10%);
		border: 2px solid rgba(var(--secondary-rgb), 0.3);
		border-radius: 12px;
		color: var(--text-color);
		text-decoration: none;
		transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		font-weight: 500;
	}

	.social-link:hover {
		background: rgba(var(--secondary-rgb), 0.12);
		border-color: var(--secondary-color);
		transform: translateY(-3px);
		box-shadow: 0 8px 25px rgba(var(--secondary-rgb), 0.3);
	}

	.link-icon {
		font-size: 1.2rem;
	}

	.link-text {
		font-weight: 600;
	}

	.scroll-indicator {
		position: absolute;
		bottom: 2rem;
		animation: bounce 2s infinite;
		font-size: 1rem;
		color: var(--secondary-color);
		font-family: system-ui, -apple-system, sans-serif;
		text-shadow: 0 0 10px var(--secondary-color);
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.scroll-indicator:hover {
		transform: scale(1.1) translateY(5px);
		text-shadow: 0 0 20px var(--secondary-color);
	}

	@keyframes bounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(10px); }
	}

	@media (max-width: 768px) {
		.hero {
			padding: 5rem 1.5rem 3rem;
		}

		.hero-content {
			padding: 2rem 1.5rem;
		}

		.title-line {
			font-size: 1.2rem;
		}

		.name-highlight {
			font-size: 2.5rem;
		}

		.hero-role {
			font-size: 1.1rem;
			flex-direction: column;
			gap: 0.5rem;
		}

		.role-divider {
			display: none;
		}

		.hero-description {
			font-size: 1rem;
		}

		.hero-badges {
			flex-direction: column;
			align-items: center;
		}

		.badge {
			width: 100%;
			max-width: 300px;
			text-align: center;
		}

		.cta-buttons {
			flex-direction: column;
			width: 100%;
		}

		.cta-buttons .btn {
			width: 100%;
			min-width: auto;
		}

		.social-links {
			flex-direction: column;
			width: 100%;
		}

		.social-link {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<script>
	import { init3DCardEffect } from '../utils/card3d';
	init3DCardEffect('.hero-container', 15);
</script>
