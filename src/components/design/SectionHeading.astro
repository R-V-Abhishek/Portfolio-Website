---
interface Props {
  number: string;
  label: string;
  title: string;
  href?: string;
  action?: string;
}
const { number, label, title, href, action = "Explore all →" } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">
      {number} / {label}
    </p>
    <h2>{title}</h2>
  </div>
  {href && (
    <a class="text-link" href={href}>
      {action}
    </a>
  )}
</div>
