---
interface Props {
	title: string;
	subtitle?: string;
	gradient?: string;
	breadcrumb?: string;
	symbol?: string;
	symbolClass?: string;
}

const {
	title,
	subtitle,
	gradient = 'var(--gradient-hero)',
	breadcrumb = title.toLowerCase(),
	symbol,
	symbolClass,
} = Astro.props;

const sectionSymbols: Record<string, { glyph: string; className: string }> = {
	about: { glyph: '◉', className: 'symbol-about' },
	skills: { glyph: '◈', className: 'symbol-skills' },
	projects: { glyph: '⌘', className: 'symbol-projects' },
	experience: { glyph: '⌬', className: 'symbol-experience' },
	contact: { glyph: '✦', className: 'symbol-contact' },
};

const symbolMeta = sectionSymbols[breadcrumb] ?? { glyph: '◉', className: 'symbol-about' };
const heroSymbol = symbol ?? symbolMeta.glyph;
const heroSymbolClass = symbolClass ?? symbolMeta.className;
---

<section class="page-hero fade-in">
	<div class="container">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/" class="breadcrumb-home">~/</a>
			<span class="breadcrumb-sep">›</span>
			<span class="breadcrumb-current" aria-current="page">
				<span class={`symbol ${heroSymbolClass}`} aria-hidden="true">{heroSymbol}</span>
				{breadcrumb}
			</span>
		</nav>
		<h1 class="page-title" style={`background-image: ${gradient};`}>
			<span class={`page-title-symbol ${heroSymbolClass}`}>{heroSymbol}</span>
			{title}
		</h1>
		{subtitle && <p class="page-subtitle">{subtitle}</p>}
		<div class="hero-line" style={`background: ${gradient};`}></div>
	</div>
</section>

<style>
	.page-hero {
		padding-top: 8rem;
		padding-bottom: 3rem;
		position: relative;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
	}

	.breadcrumb-home {
		color: var(--primary-color);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.breadcrumb-home:hover {
		color: var(--primary-light);
		text-shadow: none;
	}

	.breadcrumb-sep {
		color: var(--text-muted);
	}

	.breadcrumb-current {
		color: var(--text-light);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.page-title {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 700;
		font-family: 'JetBrains Mono', monospace;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin-bottom: 1rem;
		line-height: 1.1;
		text-shadow: none;
	}

	.page-title-symbol {
		background: none !important;
		-webkit-text-fill-color: currentColor !important;
		color: var(--primary-light);
		text-shadow: 0 0 10px currentColor;
		font-size: 0.78em;
		margin-right: 0.4rem;
		vertical-align: 0.08em;
	}

	.page-subtitle {
		font-size: 1.1rem;
		color: var(--text-light);
		max-width: 600px;
		margin-bottom: 2rem;
		line-height: 1.7;
	}

	.hero-line {
		width: 80px;
		height: 4px;
		border-radius: 2px;
		margin-top: 1rem;
	}
</style>
