---
const experiences = [
	{
		title: "Club Coordinator",
		organization: "Ninaad - Indian Music Club",
		location: "BMS College of Engineering",
		description: "Leading the Indian music club, organizing events and competitions, managing performances, and coordinating with various stakeholders to promote Indian classical music culture on campus.",
		duration: "2024-Present",
		icon: "🎵"
	},
	{
		title: "Design Department Member",
		organization: "DSYNC - Data Science Club",
		location: "BMS College of Engineering",
		description: "Key member specializing in creation of digital assets and event branding for major BMSCE events, combining technical knowledge with creative design skills.",
		duration: "2024-Present",
		icon: "🎨"
	}
];

const certifications = [
	{ name: "IBM Exploratory Data Analysis Course", issuer: "Coursera", date: "July 2025", icon: "📊" },
	{ name: "Introduction to Large Language Models", issuer: "NPTEL (IIT New Delhi)", date: "August 2025", icon: "🤖" },
	{ name: "HTML + CSS in Depth", issuer: "Meta (Coursera)", date: "July 2024", icon: "💻" }
];

const experienceColors = [
	'var(--highlight-color)',
	'var(--secondary-color)',
	'var(--accent-color)',
	'var(--primary-color)'
];
---

<section id="experience" class="experience fade-in">
	<div class="container">
		<h2 class="section-title">Experience & Certifications</h2>
		
		<div class="timeline">
			{experiences.map((exp, index) => (
				<div class="timeline-item">
					<div class="timeline-marker"></div>
					<div
						class="experience-card hoverable-card"
						style={`--flood-color: ${experienceColors[index % experienceColors.length]};`}
					>
						<div class="card-header">
							<span class="exp-icon">{exp.icon}</span>
							<div class="header-content">
								<h3 class="exp-title">{exp.title}</h3>
								<p class="exp-org">{exp.organization}</p>
							</div>
						</div>
						<div class="card-body">
							<div class="exp-meta">
								<span class="exp-location">📍 {exp.location}</span>
								<span class="exp-duration">⏱️ {exp.duration}</span>
							</div>
							<p class="exp-description">{exp.description}</p>
						</div>
					</div>
				</div>
			))}
		</div>

		<div class="certifications-section">
			<h3 class="subsection-title">Certifications</h3>
			<div class="cert-grid">
				{certifications.map((cert, index) => (
					<div
						class="cert-card hoverable-card"
						style={`--flood-color: ${experienceColors[index % experienceColors.length]};`}
					>
						<div class="cert-icon">{cert.icon}</div>
						<div class="cert-content">
							<h4 class="cert-name">{cert.name}</h4>
							<p class="cert-issuer">{cert.issuer}</p>
							<span class="cert-date">{cert.date}</span>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.experience {
		padding: 6rem 2rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 4rem;
		background: linear-gradient(135deg, var(--highlight-color), var(--accent-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.timeline {
		position: relative;
		padding-left: 2rem;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: linear-gradient(180deg, transparent, var(--highlight-color), transparent);
	}

	.timeline-item {
		position: relative;
		margin-bottom: 3rem;
	}

	.timeline-marker {
		position: absolute;
		left: -2rem;
		top: 0;
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: var(--highlight-color);
		box-shadow: 0 0 20px var(--highlight-color);
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% {
			box-shadow: 0 0 20px var(--highlight-color);
		}
		50% {
			box-shadow: 0 0 30px var(--highlight-color), 0 0 40px var(--highlight-color);
		}
	}

	.experience-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 20px;
		padding: 2rem;
		box-shadow:
			0 0 30px rgba(var(--highlight-rgb), 0.3),
			0 10px 40px rgba(0, 0, 0, 0.5),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--highlight-rgb), 0.4);
		transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		position: relative;
		overflow: hidden;
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(var(--highlight-rgb), 0.2);
	}

	.exp-icon {
		font-size: 3rem;
		filter: drop-shadow(0 0 10px var(--highlight-color));
	}

	.header-content {
		flex: 1;
	}

	.exp-title {
		font-size: 1.5rem;
		color: var(--highlight-color);
		margin: 0 0 0.5rem 0;
		font-weight: 600;
	}

	.exp-org {
		font-size: 1.1rem;
		color: var(--text-color);
		margin: 0;
		opacity: 0.9;
	}

	.card-body {
		font-family: system-ui, -apple-system, sans-serif;
	}

	.exp-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-bottom: 1rem;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	.exp-location, .exp-duration {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.exp-description {
		line-height: 1.7;
		color: var(--text-color);
		margin: 0;
	}

	.certifications-section {
		margin-top: 5rem;
	}

	.subsection-title {
		font-size: 2rem;
		text-align: center;
		margin-bottom: 2.5rem;
		color: var(--highlight-color);
		font-weight: 600;
	}

	.cert-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	.cert-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 16px;
		padding: 1.5rem;
		box-shadow:
			0 0 25px rgba(var(--highlight-rgb), 0.2),
			0 8px 30px rgba(0, 0, 0, 0.4),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--highlight-rgb), 0.3);
		transition: all 0.4s ease;
		display: flex;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	.cert-icon {
		font-size: 2.5rem;
		flex-shrink: 0;
	}

	.cert-content {
		flex: 1;
	}

	.cert-name {
		font-size: 1.1rem;
		color: var(--text-color);
		margin: 0 0 0.5rem 0;
		font-weight: 600;
	}

	.cert-issuer {
		font-size: 0.95rem;
		color: var(--text-muted);
		margin: 0 0 0.5rem 0;
	}

	.cert-date {
		display: inline-block;
		padding: 0.25rem 0.75rem;
		background: rgba(var(--highlight-rgb), 0.2);
		border: 1px solid rgba(var(--highlight-rgb), 0.3);
		border-radius: 12px;
		font-size: 0.85rem;
		color: var(--highlight-color);
		font-weight: 500;
	}

	@media (max-width: 768px) {
		.experience {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.timeline {
			padding-left: 1.5rem;
		}

		.timeline-marker {
			left: -1.6rem;
		}

		.experience-card {
			padding: 1.5rem;
		}

		.card-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.exp-icon {
			font-size: 2.5rem;
		}

		.cert-grid {
			grid-template-columns: 1fr;
		}

		.subsection-title {
			font-size: 1.5rem;
		}
	}
</style>

<script>
	import { init3DCardEffect } from '../utils/card3d';
	init3DCardEffect('.experience-card, .cert-card', 15);
</script>
