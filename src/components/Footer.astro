---
import { SITE, url } from "../data/config";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="wordmark" href={url()}>
        R V Abhishek <span class="brand-mark">✳</span>
      </a>
      <p>
        Patterns, signals, and systems.
        <br />
        Built with curiosity in Bengaluru.
      </p>
    </div>
    <div>
      <span class="eyebrow">Start a conversation</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <div class="inline-links">
        <a href={SITE.github}>GitHub ↗</a>
        <a href={SITE.linkedin}>LinkedIn ↗</a>
      </div>
    </div>
    <div>
      <span class="eyebrow">Keep exploring</span>
      <a href={url("skills/")}>Skills & Credentials ↗</a>
      <a href={url("resume.pdf")} download>
        Download resume ↓
      </a>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
  <div class="container footer-base">
    <span>© {new Date().getFullYear()} R V Abhishek</span>
    <span class="mono">A work in curiosity.</span>
  </div>
</footer>
