---
const skillCategories = [
	{
		title: "Programming Languages",
		icon: "💻",
		color: "var(--primary-color)",
		skills: ["Python", "JavaScript", "SQL", "R", "Java"]
	},
	{
		title: "Data Science & ML",
		icon: "📊",
		color: "var(--secondary-color)",
		skills: ["Scikit-learn", "Pandas", "NumPy", "Matplotlib", "Seaborn", "LLMs", "Deep Learning"]
	},
	{
		title: "Web Development",
		icon: "🌐",
		color: "var(--accent-color)",
		skills: ["React.js", "Node.js", "Express", "REST APIs", "HTML/CSS"]
	},
	{
		title: "Databases",
		icon: "🗄️",
		color: "var(--highlight-color)",
		skills: ["MongoDB Atlas", "MySQL"]
	},
	{
		title: "Tools & Platforms",
		icon: "🛠️",
		color: "var(--highlight-color)",
		skills: ["Git", "GitHub", "VSCode", "Vercel", "Render", "Figma", "Android Studio"]
	}
];
---

<section id="skills" class="skills fade-in">
	<div class="container">
		<h2 class="section-title">Skills & Technologies</h2>
		<div class="skills-grid">
			{skillCategories.map((category) => (
				<div class="skill-card hoverable-card" style={`--category-color: ${category.color}; --flood-color: ${category.color};`}>
					<div class="skill-header">
						<span class="skill-icon">{category.icon}</span>
						<h3 class="skill-category-title">{category.title}</h3>
					</div>
					<div class="skill-tags">
						{category.skills.map(skill => (
							<span class="skill-tag">{skill}</span>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.skills {
		padding: 6rem 2rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 3rem;
		background: linear-gradient(135deg, var(--secondary-color), var(--accent-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.skill-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 20px;
		padding: 2rem;
		box-shadow:
			0 0 30px color-mix(in srgb, var(--category-color) 20%, transparent),
			0 10px 40px rgba(0, 0, 0, 0.3),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid color-mix(in srgb, var(--category-color) 30%, transparent);
		transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		position: relative;
		overflow: hidden;
	}

	.skill-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.skill-icon {
		font-size: 2.5rem;
		filter: drop-shadow(0 0 10px var(--category-color));
	}

	.skill-category-title {
		font-size: 1.5rem;
		color: var(--category-color);
		margin: 0;
	}

	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.skill-tag {
		padding: 0.5rem 1rem;
		background: color-mix(in srgb, var(--category-color) 15%, transparent);
		border: 1px solid color-mix(in srgb, var(--category-color) 30%, transparent);
		border-radius: 20px;
		color: var(--text-color);
		font-size: 0.9rem;
		font-weight: 500;
		transition: all 0.3s ease;
		cursor: default;
	}

	.skill-tag:hover {
		background: color-mix(in srgb, var(--category-color) 25%, transparent);
		border-color: var(--category-color);
		box-shadow: 0 4px 12px color-mix(in srgb, var(--category-color) 30%, transparent);
	}

	@media (max-width: 768px) {
		.skills {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.skills-grid {
			grid-template-columns: 1fr;
		}

		.skill-card {
			padding: 1.5rem;
		}
	}
</style>

<script>
	import { init3DCardEffect } from '../utils/card3d';
	init3DCardEffect('.skill-card', 15);
</script>
