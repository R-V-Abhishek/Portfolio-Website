---
import { experiences, certifications } from '../../data/experience.js';

const previewColors = [
	'var(--highlight-color)',
	'var(--secondary-color)',
	'var(--accent-color)',
	'var(--primary-color)'
];
---

<section class="exp-preview fade-in">
	<div class="container">
		<div class="section-eyebrow section-eyebrow-center">[ <span class="symbol symbol-experience">⌬</span>My Journey ]</div>
		<h2 class="section-title">Experience & Certifications</h2>

		<div class="preview-grid">
			<div class="exp-col">
				<h3 class="col-label">// Roles</h3>
				{experiences.map((exp, index) => (
					<div
						class="exp-card hoverable-card"
						style={`--flood-color: ${previewColors[index % previewColors.length]};`}
					>
						<div class="exp-header">
							<span class="exp-icon" aria-hidden="true">{exp.icon}</span>
							<div class="exp-meta">
								<div class="exp-title">{exp.title}</div>
								<div class="exp-org">{exp.organization}</div>
								<div class="exp-location"><span aria-hidden="true">📍</span> {exp.location}</div>
							</div>
							<span class="exp-duration">{exp.duration}</span>
						</div>
						<p class="exp-description">{exp.description}</p>
					</div>
				))}
			</div>

			<div class="cert-col">
				<h3 class="col-label">// Certifications</h3>
				{certifications.map((cert, index) => (
					<div
						class="cert-card hoverable-card"
						style={`--flood-color: ${previewColors[index % previewColors.length]};`}
					>
						<span class="cert-icon" aria-hidden="true">{cert.icon}</span>
						<div class="cert-body">
							<div class="cert-name">{cert.name}</div>
							<div class="cert-meta">{cert.issuer} · {cert.date}</div>
						</div>
					</div>
				))}
			</div>
		</div>

		<div class="view-more">
			<a href="/experience" class="btn btn-secondary">View Full Experience & Certifications →</a>
		</div>
	</div>
</section>

<style>
	.exp-preview {
		background: var(--bg-color);
	}

	.section-title {
		background: var(--gradient-section-experience);
	}

	.preview-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
		margin-bottom: 3rem;
	}

	.col-label {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		color: var(--text-muted);
		font-weight: 600;
		margin: 0 0 1.25rem 0;
		letter-spacing: 0.05em;
	}

	/* Experience cards */
	.exp-card {
		background: var(--card-bg);
		border-radius: 12px;
		padding: 1.25rem;
		border: 2px solid rgba(var(--primary-rgb), 0.22);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
		margin-bottom: 1rem;
	}

	.exp-header {
		display: flex;
		align-items: flex-start;
		gap: 0.875rem;
	}

	.exp-icon {
		font-size: 1.75rem;
		flex-shrink: 0;
		margin-top: 0.1rem;
	}

	.exp-meta {
		flex: 1;
	}

	.exp-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--heading-color);
		font-family: 'JetBrains Mono', monospace;
		margin-bottom: 0.25rem;
	}

	.exp-org {
		font-size: 0.88rem;
		color: var(--primary-light);
	}

	.exp-location {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', monospace;
		margin-top: 0.35rem;
	}

	.exp-duration {
		font-size: 0.78rem;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', monospace;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.exp-description {
		margin-top: 0.9rem;
		font-size: 0.88rem;
		line-height: 1.55;
		color: var(--text-light);
	}

	/* Hover overrides */
	.exp-card:hover .exp-title,
	.exp-card:hover .exp-org,
	.exp-card:hover .exp-location,
	.exp-card:hover .exp-description,
	.exp-card:hover .exp-duration {
		color: var(--card-hover-fg);
	}

	/* Cert cards */
	.cert-card {
		background: var(--card-bg);
		border-radius: 12px;
		padding: 1.1rem 1.25rem;
		border: 2px solid rgba(var(--highlight-rgb), 0.22);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.cert-icon {
		font-size: 1.6rem;
		flex-shrink: 0;
	}

	.cert-name {
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--heading-color);
		margin-bottom: 0.25rem;
		line-height: 1.35;
	}

	.cert-meta {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', monospace;
	}

	.cert-card:hover .cert-name,
	.cert-card:hover .cert-meta {
		color: var(--card-hover-fg);
	}

	@media (max-width: 768px) {
		.preview-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
