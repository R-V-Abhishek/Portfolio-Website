---
import { experiences, certifications } from '../../data/experience.js';
const recentExp = experiences[0];
---

<section class="exp-preview fade-in">
	<div class="container">
		<div class="section-eyebrow">[ My Journey ]</div>
		<h2 class="section-title">Experience</h2>

		<div class="preview-grid">
			<div class="exp-col">
				<h3 class="col-label">// Roles</h3>
				{experiences.map((exp) => (
					<div class="exp-card hoverable-card" style="--flood-color: var(--primary-color);">
						<div class="exp-header">
							<span class="exp-icon">{exp.icon}</span>
							<div class="exp-meta">
								<div class="exp-title">{exp.title}</div>
								<div class="exp-org">{exp.organization}</div>
							</div>
							<span class="exp-duration">{exp.duration}</span>
						</div>
					</div>
				))}
			</div>

			<div class="cert-col">
				<h3 class="col-label">// Certifications</h3>
				{certifications.map((cert) => (
					<div class="cert-card hoverable-card" style="--flood-color: var(--highlight-color);">
						<span class="cert-icon">{cert.icon}</span>
						<div class="cert-body">
							<div class="cert-name">{cert.name}</div>
							<div class="cert-meta">{cert.issuer} · {cert.date}</div>
						</div>
					</div>
				))}
			</div>
		</div>

		<div class="view-more">
			<a href="/experience" class="btn btn-secondary">View Full Experience →</a>
		</div>
	</div>
</section>

<style>
	.exp-preview {
		padding: 6rem 2rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-eyebrow {
		text-align: center;
		margin-bottom: 0.75rem;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 3rem;
		background: linear-gradient(135deg, var(--highlight-color), var(--accent-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.preview-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
		margin-bottom: 3rem;
	}

	.col-label {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		color: var(--text-muted);
		font-weight: 600;
		margin: 0 0 1.25rem 0;
		letter-spacing: 0.05em;
	}

	/* Experience cards */
	.exp-card {
		background: var(--card-bg);
		border-radius: 12px;
		padding: 1.25rem;
		border: 2px solid rgba(var(--primary-rgb), 0.22);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
		margin-bottom: 1rem;
	}

	.exp-header {
		display: flex;
		align-items: flex-start;
		gap: 0.875rem;
	}

	.exp-icon {
		font-size: 1.75rem;
		flex-shrink: 0;
		margin-top: 0.1rem;
	}

	.exp-meta {
		flex: 1;
	}

	.exp-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--heading-color);
		font-family: 'JetBrains Mono', monospace;
		margin-bottom: 0.25rem;
	}

	.exp-org {
		font-size: 0.88rem;
		color: var(--primary-light);
	}

	.exp-duration {
		font-size: 0.78rem;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', monospace;
		white-space: nowrap;
		flex-shrink: 0;
	}

	/* Hover overrides */
	.exp-card:hover .exp-title,
	.exp-card:hover .exp-org,
	.exp-card:hover .exp-duration {
		color: #07071a;
	}

	/* Cert cards */
	.cert-card {
		background: var(--card-bg);
		border-radius: 12px;
		padding: 1.1rem 1.25rem;
		border: 2px solid rgba(var(--highlight-rgb), 0.22);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.cert-icon {
		font-size: 1.6rem;
		flex-shrink: 0;
	}

	.cert-name {
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--heading-color);
		margin-bottom: 0.25rem;
		line-height: 1.35;
	}

	.cert-meta {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', monospace;
	}

	.cert-card:hover .cert-name,
	.cert-card:hover .cert-meta {
		color: #07071a;
	}

	.view-more {
		text-align: center;
	}

	@media (max-width: 768px) {
		.exp-preview {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.preview-grid {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.cert-col {
			margin-top: 2rem;
		}
	}
</style>
