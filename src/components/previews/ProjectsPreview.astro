---
import { featuredProjects } from '../../data/projects.js';

const categoryColor: Record<string, string> = {
	'full-stack':   'var(--primary-color)',
	'data-science': 'var(--secondary-color)',
	'backend':      'var(--accent-color)',
	'other':        'var(--highlight-color)',
};

const previewColors = [
	'var(--accent-color)',
	'var(--secondary-color)',
	'var(--primary-color)',
	'var(--highlight-color)'
];

// Hard cap at 2 cards on homepage
const previewProjects = featuredProjects.slice(0, 2);
---

<section class="projects-preview fade-in">
	<div class="container">
		<div class="section-eyebrow section-eyebrow-center">[ <span class="symbol symbol-projects">⌘</span>My Work ]</div>
		<h2 class="section-title">Projects</h2>

		<div class="projects-grid">
			{previewProjects.map((project, index) => (
				<div
					class="project-card hoverable-card"
					style={`--flood-color: ${previewColors[index % previewColors.length]}; --project-color: ${previewColors[index % previewColors.length]};`}
				>
					<div class="card-header">
						<span class="file-icon" aria-hidden="true">📁</span>
						<span class="status-badge" data-status={project.status}>[{project.status}]</span>
					</div>
					<h3 class="project-title">{project.title}</h3>
					<p class="project-description">{project.description}</p>
					<p class="project-impact"><span class="impact-symbol" aria-hidden="true">⟢</span>{project.impact}</p>
					<div class="project-tech">
						<span class="tech-label">Tech Stack</span>
						<div class="tech-list">
							{project.tech.map(tech => (
								<span class="tech-badge">{tech}</span>
							))}
						</div>
					</div>
					<div class="project-links">
						{project.githubLink && (
							<a href={project.githubLink} target="_blank" rel="noopener noreferrer" class="project-link">
								GitHub<span class="sr-only"> (opens in new tab)</span>
							</a>
						)}
						{project.liveLink && (
							<a href={project.liveLink} target="_blank" rel="noopener noreferrer" class="project-link live">
								Live Demo<span class="sr-only"> (opens in new tab)</span>
							</a>
						)}
					</div>
				</div>
			))}
		</div>

		<div class="view-more">
			<a href="/projects" class="btn btn-primary">View Full Projects →</a>
		</div>
	</div>
</section>

<style>
	.projects-preview {
		background: var(--bg-secondary);
	}

	.section-title {
		background: var(--gradient-accent);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.project-card {
		background: var(--card-bg);
		border-radius: 16px;
		padding: 1.5rem;
		border: 2px solid color-mix(in srgb, var(--project-color, var(--primary-color)) 25%, transparent);
		box-shadow:
			0 0 18px color-mix(in srgb, var(--project-color, var(--primary-color)) 10%, transparent),
			var(--shadow-card);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		font-size: 1.2rem;
	}

	.status-badge {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--success-color);
	}

	.status-badge[data-status="completed"] {
		color: var(--secondary-color);
	}

	.project-title {
		font-size: 1.3rem;
		color: var(--primary-light);
		margin: 0 0 0.75rem 0;
		font-weight: 700;
		font-family: 'JetBrains Mono', monospace;
	}

	.project-description {
		color: var(--text-light);
		line-height: 1.7;
		margin-bottom: 1.25rem;
		font-size: 0.92rem;
	}

	.project-impact {
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0 0 1.1rem 0;
		font-family: 'JetBrains Mono', monospace;
	}

	.impact-symbol {
		color: var(--secondary-color);
		line-height: 1.3;
		flex-shrink: 0;
	}

	.project-tech {
		margin-bottom: 1.25rem;
	}

	.tech-label {
		color: var(--text-muted);
		font-size: 0.8rem;
		font-family: 'JetBrains Mono', monospace;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		display: block;
		margin-bottom: 0.6rem;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tech-badge {
		color: var(--secondary-color);
		font-size: 0.8rem;
		font-family: 'JetBrains Mono', monospace;
		background: rgba(var(--secondary-rgb), 0.1);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		border: 1px solid rgba(var(--secondary-rgb), 0.22);
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.project-link {
		color: var(--primary-color);
		text-decoration: none;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		border: 1px solid rgba(var(--primary-rgb), 0.4);
		padding: 0.35rem 0.9rem;
		border-radius: 6px;
		background: rgba(var(--primary-rgb), 0.06);
		transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
		font-weight: 600;
	}

	.project-link:hover {
		background: var(--primary-color);
		color: var(--bg-color);
		border-color: var(--primary-color);
		box-shadow: 0 0 25px rgba(var(--primary-rgb), 0.6);
	}

	.project-link.live {
		color: var(--accent-color);
		border-color: rgba(var(--accent-rgb), 0.4);
		background: rgba(var(--accent-rgb), 0.06);
	}

	.project-link.live:hover {
		background: var(--accent-color);
		color: var(--bg-color);
		border-color: var(--accent-color);
		box-shadow: 0 0 25px rgba(var(--accent-rgb), 0.6);
	}

	@media (max-width: 768px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
