---
import { featuredProjects } from '../../data/projects.js';
---

<section class="projects-preview fade-in">
	<div class="container">
		<div class="section-eyebrow">[ My Work ]</div>
		<h2 class="section-title">Featured Projects</h2>

		<div class="projects-grid">
			{featuredProjects.map((project) => (
				<div
					class="project-card hoverable-card"
					style="--flood-color: var(--primary-color);"
				>
					<div class="card-header">
						<span class="file-icon">📁</span>
						<span class="status-badge" data-status={project.status}>[{project.status}]</span>
					</div>
					<h3 class="project-title">{project.title}</h3>
					<p class="project-description">{project.description}</p>
					<div class="project-tech">
						<div class="tech-list">
							{project.tech.map(tech => (
								<span class="tech-badge">{tech}</span>
							))}
						</div>
					</div>
					<div class="project-links">
						{project.githubLink && (
							<a href={project.githubLink} target="_blank" rel="noopener noreferrer" class="project-link">
								GitHub
							</a>
						)}
						{project.liveLink && (
							<a href={project.liveLink} target="_blank" rel="noopener noreferrer" class="project-link live">
								Live Demo
							</a>
						)}
					</div>
				</div>
			))}
		</div>

		<div class="view-more">
			<a href="/projects" class="btn btn-primary">View All Projects →</a>
		</div>
	</div>
</section>

<style>
	.projects-preview {
		padding: 6rem 2rem;
		background: var(--bg-secondary);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-eyebrow {
		text-align: center;
		margin-bottom: 0.75rem;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 3rem;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.project-card {
		background: var(--card-bg);
		border-radius: 16px;
		padding: 1.5rem;
		border: 2px solid rgba(var(--primary-rgb), 0.25);
		box-shadow: var(--shadow-card);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		font-size: 1.2rem;
	}

	.status-badge {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--success-color);
	}

	.status-badge[data-status="completed"] {
		color: var(--secondary-color);
	}

	.project-title {
		font-size: 1.3rem;
		color: var(--primary-light);
		margin: 0 0 0.75rem 0;
		font-weight: 700;
		font-family: 'JetBrains Mono', monospace;
	}

	.project-description {
		color: var(--text-light);
		line-height: 1.7;
		margin-bottom: 1.25rem;
		font-size: 0.92rem;
	}

	.project-tech {
		margin-bottom: 1.25rem;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tech-badge {
		color: var(--secondary-color);
		font-size: 0.8rem;
		font-family: 'JetBrains Mono', monospace;
		background: rgba(var(--secondary-rgb), 0.1);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		border: 1px solid rgba(var(--secondary-rgb), 0.22);
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.project-link {
		color: var(--primary-color);
		text-decoration: none;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		border: 1px solid rgba(var(--primary-rgb), 0.4);
		padding: 0.35rem 0.9rem;
		border-radius: 6px;
		background: rgba(var(--primary-rgb), 0.06);
		transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
		font-weight: 600;
	}

	.project-link:hover {
		background: rgba(var(--primary-rgb), 0.15);
		border-color: var(--primary-color);
		box-shadow: var(--glow-primary);
		transform: translateY(-2px);
	}

	.project-link.live {
		color: var(--accent-color);
		border-color: rgba(var(--accent-rgb), 0.4);
		background: rgba(var(--accent-rgb), 0.06);
	}

	.project-link.live:hover {
		background: rgba(var(--accent-rgb), 0.15);
		border-color: var(--accent-color);
		box-shadow: var(--glow-pink);
	}

	/* Hover overrides */
	.project-card:hover .project-title,
	.project-card:hover .status-badge {
		color: #07071a;
	}

	.project-card:hover .project-link,
	.project-card:hover .project-link.live {
		color: #07071a;
		border-color: rgba(0, 0, 0, 0.3);
		background: rgba(0, 0, 0, 0.12);
		box-shadow: none;
	}

	.view-more {
		text-align: center;
	}

	@media (max-width: 768px) {
		.projects-preview {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
