---
interface Props {
	end: number;
	label: string;
	sublabel?: string;
	suffix?: string;
	prefix?: string;
	decimals?: number;
	duration?: number;
	color?: string;
}

const {
	end,
	label,
	sublabel,
	suffix = '',
	prefix = '',
	decimals = 0,
	duration = 1800,
	color = 'var(--primary-color)',
} = Astro.props;
---

<div class="stat-item">
	<div class="stat-number" style={`color: ${color}; --stat-color: ${color};`}>
		{prefix}<span
			class="counter-value"
			data-counter={end}
			data-decimals={decimals}
			data-suffix={suffix}
			data-duration={duration}
		>{end.toFixed(decimals)}</span>{suffix}
	</div>
	<div class="stat-label">{label}</div>
	{sublabel && <div class="stat-sublabel">{sublabel}</div>}
</div>

<style>
	.stat-item {
		text-align: center;
		padding: 1.5rem 1rem;
		position: relative;
	}

	.stat-item::after {
		content: '';
		position: absolute;
		right: 0;
		top: 20%;
		height: 60%;
		width: 1px;
		background: rgba(var(--primary-rgb), 0.15);
	}

	.stat-item:last-child::after {
		display: none;
	}

	.stat-number {
		font-family: 'JetBrains Mono', monospace;
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 700;
		line-height: 1;
		margin-bottom: 0.5rem;
		filter: drop-shadow(0 0 12px var(--stat-color, var(--primary-color)));
		color: inherit;
	}

	.stat-label {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-light);
	}

	.stat-sublabel {
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-top: 0.25rem;
		font-family: 'JetBrains Mono', monospace;
	}
</style>

<script>
	function runCounter(el: HTMLElement) {
		const end      = parseFloat(el.dataset.counter   ?? '0');
		const decimals = parseInt(el.dataset.decimals    ?? '0', 10);
		const suffix   = el.dataset.suffix               ?? '';
		const duration = parseInt(el.dataset.duration    ?? '1800', 10);

		const start     = 0;
		const startTime = performance.now();

		function easeOutQuart(t: number): number {
			return 1 - Math.pow(1 - t, 4);
		}

		function step(now: number) {
			const elapsed  = now - startTime;
			const progress = Math.min(elapsed / duration, 1);
			const current  = start + (end - start) * easeOutQuart(progress);

			el.textContent = current.toFixed(decimals) + suffix;

			if (progress < 1) {
				requestAnimationFrame(step);
			} else {
				el.textContent = end.toFixed(decimals) + suffix;
			}
		}

		requestAnimationFrame(step);
	}

	// Trigger each counter when it scrolls into view
	const counters = document.querySelectorAll<HTMLElement>('.counter-value');

	const io = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				runCounter(entry.target as HTMLElement);
				io.unobserve(entry.target);
			}
		});
	}, { threshold: 0.4 });

	counters.forEach(el => io.observe(el));
</script>
