---
---

<section id="about" class="about fade-in">
	<div class="container">
		<h2 class="section-title">About Me</h2>
		<div class="about-content">
			<div class="intro-card hoverable-card" style="--flood-color: var(--primary-color);">
				<h3 class="intro-title">Hi, I'm R V Abhishek 👋</h3>
				<p class="intro-text">
					A <strong>Full-Stack Developer</strong> and <strong>Data Science enthusiast</strong> passionate about building innovative solutions that make a difference. Currently pursuing B.E. in Computer Science Engineering (Data Science) at BMS College of Engineering, Bengaluru.
				</p>
				<p class="intro-text">
					I bring a unique blend of technical excellence and creative artistry, being not just a developer but also a professional Carnatic musician. This combination helps me approach problems with both analytical precision and creative thinking.
				</p>
			</div>

			<div class="education-card hoverable-card" style="--flood-color: var(--secondary-color);">
				<div class="card-icon">🎓</div>
				<h4 class="card-title">Education</h4>
				<p class="degree">B.E. Computer Science Engineering (Data Science)</p>
				<p class="institution">BMS College of Engineering, Bengaluru</p>
				<p class="cgpa">CGPA: <strong>9.67</strong> | Pre-University: <strong>99%</strong></p>
				<span class="status-badge">Currently Pursuing</span>
			</div>

			<div class="highlights-grid">
				<div class="highlight-card hoverable-card" style="--flood-color: var(--accent-color);">
					<div class="highlight-icon">💻</div>
					<h5 class="highlight-title">Technical</h5>
					<p class="highlight-desc">Full Stack + ML/AI</p>
				</div>
				<div class="highlight-card hoverable-card" style="--flood-color: var(--accent-color);">
					<div class="highlight-icon">🎵</div>
					<h5 class="highlight-title">Creative</h5>
					<p class="highlight-desc">Carnatic Vocalist</p>
				</div>
				<div class="highlight-card hoverable-card" style="--flood-color: var(--accent-color);">
					<div class="highlight-icon">🤝</div>
					<h5 class="highlight-title">Leadership</h5>
					<p class="highlight-desc">Club Coordinator</p>
				</div>
			</div>

			<div class="expertise-card hoverable-card" style="--flood-color: var(--highlight-color);">
				<h4 class="card-title">Areas of Expertise</h4>
				<div class="expertise-list">
					<div class="expertise-item">
						<span class="expertise-icon">⚡</span>
						<span class="expertise-text">Full-Stack Development</span>
					</div>
					<div class="expertise-item">
						<span class="expertise-icon">📊</span>
						<span class="expertise-text">Data Science & Analytics</span>
					</div>
					<div class="expertise-item">
						<span class="expertise-icon">🤖</span>
						<span class="expertise-text">Machine Learning & AI</span>
					</div>
					<div class="expertise-item">
						<span class="expertise-icon">☁️</span>
						<span class="expertise-text">Cloud Computing (AWS)</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		padding: 6rem 2rem;
		background: var(--section-bg);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 3rem;
		background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.about-content {
		display: grid;
		gap: 2rem;
	}

	.intro-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 20px;
		padding: 2.5rem;
		box-shadow:
			0 0 40px rgba(var(--primary-rgb), 0.2),
			0 10px 40px rgba(0, 0, 0, 0.5),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--primary-rgb), 0.3);
		transition: all 0.4s ease;
		position: relative;
		overflow: hidden;
	}

	.intro-title {
		font-size: 2rem;
		margin-bottom: 1.5rem;
		color: var(--heading-color);
	}

	.intro-text {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-color);
		margin-bottom: 1rem;
		font-family: system-ui, -apple-system, sans-serif;
	}

	.intro-text strong {
		color: var(--primary-color);
		font-weight: 600;
	}

	.education-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 20px;
		padding: 2rem;
		box-shadow:
			0 0 40px rgba(var(--secondary-rgb), 0.2),
			0 10px 40px rgba(0, 0, 0, 0.5),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--secondary-rgb), 0.3);
		transition: all 0.4s ease;
		position: relative;
		overflow: hidden;
	}

	.card-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.card-title {
		font-size: 1.5rem;
		color: var(--secondary-color);
		margin-bottom: 1rem;
	}

	.degree {
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--heading-color);
		margin-bottom: 0.5rem;
	}

	.institution {
		font-size: 1.1rem;
		color: var(--text-light);
		margin-bottom: 0.75rem;
	}

	.cgpa {
		font-size: 1rem;
		color: var(--text-color);
		margin-bottom: 1rem;
	}

	.cgpa strong {
		color: var(--primary-color);
	}

	.status-badge {
		display: inline-block;
		padding: 0.5rem 1rem;
		background: rgba(var(--primary-rgb), 0.1);
		border: 1px solid var(--primary-color);
		border-radius: 20px;
		color: var(--primary-color);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.highlights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
	}

	.highlight-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 16px;
		padding: 2rem;
		box-shadow:
			0 0 30px rgba(var(--accent-rgb), 0.2),
			0 8px 32px rgba(0, 0, 0, 0.5),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--accent-rgb), 0.3);
		text-align: center;
		transition: all 0.4s ease;
		position: relative;
		overflow: hidden;
	}

	.highlight-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		filter: drop-shadow(0 0 10px rgba(var(--accent-rgb), 0.5));
	}

	.highlight-title {
		font-size: 1.2rem;
		color: var(--accent-color);
		margin-bottom: 0.5rem;
	}

	.highlight-desc {
		color: var(--text-light);
		font-size: 0.95rem;
	}

	.expertise-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 20px;
		padding: 2rem;
		box-shadow:
			0 0 40px rgba(var(--highlight-rgb), 0.2),
			0 10px 40px rgba(0, 0, 0, 0.5),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--highlight-rgb), 0.3);
		transition: all 0.4s ease;
		position: relative;
		overflow: hidden;
	}

	.expertise-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
	}

	.expertise-item {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
		background: rgba(var(--highlight-rgb), 0.1);
		border-radius: 12px;
		transition: all 0.3s ease;
	}

	.expertise-item:hover {
		background: rgba(var(--highlight-rgb), 0.2);
	}

	.expertise-icon {
		font-size: 2rem;
	}

	.expertise-text {
		font-size: 1.05rem;
		color: var(--text-color);
		font-weight: 500;
	}

	@media (max-width: 768px) {
		.about {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.intro-card {
			padding: 1.5rem;
		}

		.intro-title {
			font-size: 1.5rem;
		}

		.highlights-grid {
			grid-template-columns: 1fr;
		}

		.expertise-list {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { init3DCardEffect } from '../utils/card3d';
	init3DCardEffect('.intro-card, .education-card, .highlight-card, .expertise-card', 15);
</script>
