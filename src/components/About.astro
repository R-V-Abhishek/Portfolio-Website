---
---

<section id="about" class="about fade-in">
	<div class="container">
		<div class="section-eyebrow">[ About Me ]</div>
		<h2 class="section-title">About Me</h2>
		<div class="about-content">
			<div class="intro-card hoverable-card" style="--flood-color: var(--primary-color);">
				<h3 class="intro-title">Hi, I'm R V Abhishek 👋</h3>
				<p class="intro-text">
					A <strong>Full-Stack Developer</strong> and <strong>Data Science enthusiast</strong> passionate about building innovative solutions that make a difference. Currently pursuing B.E. in Computer Science Engineering (Data Science) at BMS College of Engineering, Bengaluru.
				</p>
				<p class="intro-text">
					I bring a unique blend of technical excellence and creative artistry, being not just a developer but also a professional Carnatic musician. This combination helps me approach problems with both analytical precision and creative thinking.
				</p>
			</div>

			<div class="education-card hoverable-card" style="--flood-color: var(--secondary-color);">
				<div class="card-icon">🎓</div>
				<h4 class="card-title">Education</h4>
				<p class="degree">B.E. Computer Science Engineering (Data Science)</p>
				<p class="institution">BMS College of Engineering, Bengaluru</p>
				<p class="cgpa">CGPA: <strong data-counter="9.67" data-decimals="2" data-duration="1400">9.67</strong> | Pre-University: <strong>99%</strong></p>
				<span class="status-badge">Currently Pursuing</span>
			</div>

			<div class="highlights-grid">
				<div class="highlight-card hoverable-card" style="--flood-color: var(--accent-color);">
					<div class="highlight-icon">💻</div>
					<h5 class="highlight-title">Technical</h5>
					<p class="highlight-desc">Full Stack + ML/AI</p>
				</div>
				<div class="highlight-card hoverable-card" style="--flood-color: var(--accent-color);">
					<div class="highlight-icon">🎵</div>
					<h5 class="highlight-title">Creative</h5>
					<p class="highlight-desc">Carnatic Vocalist</p>
				</div>
				<div class="highlight-card hoverable-card" style="--flood-color: var(--accent-color);">
					<div class="highlight-icon">🤝</div>
					<h5 class="highlight-title">Leadership</h5>
					<p class="highlight-desc">Club Coordinator</p>
				</div>
			</div>

			<div class="expertise-card hoverable-card" style="--flood-color: var(--highlight-color);">
				<h4 class="card-title expertise-title">Areas of Expertise</h4>
				<div class="expertise-list">
					<div class="expertise-item">
						<span class="expertise-icon">⚡</span>
						<span class="expertise-text">Full-Stack Development</span>
					</div>
					<div class="expertise-item">
						<span class="expertise-icon">📊</span>
						<span class="expertise-text">Data Science & Analytics</span>
					</div>
					<div class="expertise-item">
						<span class="expertise-icon">🤖</span>
						<span class="expertise-text">Machine Learning & AI</span>
					</div>
					<div class="expertise-item">
						<span class="expertise-icon">☁️</span>
						<span class="expertise-text">Cloud Computing (AWS)</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		padding: 6rem 2rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-eyebrow {
		text-align: center;
		margin-bottom: 0.75rem;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 3rem;
		background: var(--gradient-hero);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.about-content {
		display: grid;
		gap: 2rem;
	}

	/* ---- Intro Card ---- */
	.intro-card {
		background: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 20px;
		padding: 2.5rem;
		border: 2px solid rgba(var(--primary-rgb), 0.25);
		box-shadow: 0 0 30px rgba(var(--primary-rgb), 0.1), 0 10px 40px rgba(0, 0, 0, 0.4);
	}

	.intro-title {
		font-size: 2rem;
		margin-bottom: 1.5rem;
		color: var(--heading-color);
	}

	.intro-text {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-color);
		margin-bottom: 1rem;
	}

	.intro-text strong {
		color: var(--primary-color);
		font-weight: 600;
	}

	.intro-card:hover .intro-text strong {
		color: #07071a;
	}

	/* ---- Education Card ---- */
	.education-card {
		background: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 20px;
		padding: 2rem;
		border: 2px solid rgba(var(--secondary-rgb), 0.25);
		box-shadow: 0 0 30px rgba(var(--secondary-rgb), 0.1), 0 10px 40px rgba(0, 0, 0, 0.4);
	}

	.card-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.card-title {
		font-size: 1.5rem;
		color: var(--secondary-color);
		margin-bottom: 1rem;
		font-family: 'JetBrains Mono', monospace;
	}

	.education-card:hover .card-title {
		color: #07071a;
	}

	.degree {
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--heading-color);
		margin-bottom: 0.5rem;
	}

	.institution {
		font-size: 1.1rem;
		color: var(--text-light);
		margin-bottom: 0.75rem;
	}

	.cgpa {
		font-size: 1rem;
		color: var(--text-color);
		margin-bottom: 1rem;
		font-family: 'JetBrains Mono', monospace;
	}

	.cgpa strong {
		color: var(--primary-color);
	}

	.education-card:hover .cgpa strong {
		color: #07071a;
	}

	.status-badge {
		display: inline-block;
		padding: 0.5rem 1rem;
		background: rgba(var(--primary-rgb), 0.1);
		border: 1px solid var(--primary-color);
		border-radius: 20px;
		color: var(--primary-color);
		font-size: 0.9rem;
		font-weight: 600;
		font-family: 'JetBrains Mono', monospace;
	}

	.education-card:hover .status-badge {
		background: rgba(0, 0, 0, 0.15);
		border-color: #07071a;
		color: #07071a;
	}

	/* ---- Highlight Cards ---- */
	.highlights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
	}

	.highlight-card {
		background: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 16px;
		padding: 2rem;
		border: 2px solid rgba(var(--accent-rgb), 0.25);
		box-shadow: 0 0 20px rgba(var(--accent-rgb), 0.1), 0 8px 30px rgba(0, 0, 0, 0.4);
		text-align: center;
	}

	.highlight-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		filter: drop-shadow(0 0 10px rgba(var(--accent-rgb), 0.5));
	}

	.highlight-title {
		font-size: 1.2rem;
		color: var(--accent-color);
		margin-bottom: 0.5rem;
		font-family: 'JetBrains Mono', monospace;
	}

	.highlight-card:hover .highlight-title {
		color: #07071a;
	}

	.highlight-desc {
		color: var(--text-light);
		font-size: 0.95rem;
	}

	/* ---- Expertise Card ---- */
	.expertise-card {
		background: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 20px;
		padding: 2rem;
		border: 2px solid rgba(var(--highlight-rgb), 0.25);
		box-shadow: 0 0 30px rgba(var(--highlight-rgb), 0.1), 0 10px 40px rgba(0, 0, 0, 0.4);
	}

	.expertise-title {
		color: var(--highlight-color);
	}

	.expertise-card:hover .expertise-title {
		color: #07071a;
	}

	.expertise-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		margin-top: 0.5rem;
	}

	.expertise-item {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
		background: rgba(var(--highlight-rgb), 0.08);
		border-radius: 12px;
		border: 1px solid rgba(var(--highlight-rgb), 0.15);
		transition: background 0.3s ease, transform 0.3s ease;
	}

	.expertise-item:hover {
		background: rgba(var(--highlight-rgb), 0.15);
		transform: translateX(5px);
	}

	.expertise-card:hover .expertise-item {
		background: rgba(0, 0, 0, 0.12);
		border-color: rgba(0, 0, 0, 0.2);
	}

	.expertise-icon {
		font-size: 2rem;
	}

	.expertise-text {
		font-size: 1.05rem;
		color: var(--text-color);
		font-weight: 500;
	}

	@media (max-width: 768px) {
		.about {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.intro-card {
			padding: 1.5rem;
		}

		.intro-title {
			font-size: 1.5rem;
		}

		.highlights-grid {
			grid-template-columns: 1fr;
		}

		.expertise-list {
			grid-template-columns: 1fr;
		}
	}
</style>
