---
const contactInfo = [
	{ icon: "📧", label: "Email", value: "rvabhi2504@gmail.com", link: "mailto:rvabhi2504@gmail.com", color: "var(--primary-color)" },
	{ icon: "💼", label: "LinkedIn", value: "r-v-abhishek", link: "https://www.linkedin.com/in/r-v-abhishek", color: "var(--secondary-color)" },
	{ icon: "💻", label: "GitHub", value: "R-V-Abhishek", link: "https://github.com/R-V-Abhishek", color: "var(--highlight-color)" },
	{ icon: "📱", label: "Phone", value: "+91 83299 65881", link: "tel:+918329965881", color: "var(--accent-color)" }
];
---

<section id="contact" class="contact fade-in">
	<div class="container">
		<h2 class="section-title">Get In Touch</h2>
		<p class="section-subtitle">Let's collaborate and create something amazing together!</p>
		
		<div class="contact-grid">
			{contactInfo.map((info) => (
				<a href={info.link} target="_blank" rel="noopener noreferrer" class="contact-card hoverable-card" style={`--card-color: ${info.color}; --flood-color: ${info.color};`}>
					<div class="contact-icon">{info.icon}</div>
					<div class="contact-content">
						<h3 class="contact-label">{info.label}</h3>
						<p class="contact-value">{info.value}</p>
					</div>
				</a>
			))}
		</div>

		<div class="form-container hoverable-card" style="--flood-color: var(--secondary-color);">
			<h3 class="form-title">Send a Message</h3>
			<form action="https://formsubmit.co/rvabhi2504@gmail.com" method="POST" class="contact-form">
				<input type="hidden" name="_subject" value="Portfolio contact form submission" />
				<input type="hidden" name="_captcha" value="false" />
				<input type="hidden" name="_template" value="table" />
				<input type="hidden" name="_next" value="https://rvabhishek.dev/contact" />
				<div class="form-group">
					<label for="name">Name</label>
					<input type="text" id="name" name="name" required placeholder="Your name">
				</div>
				<div class="form-group">
					<label for="email">Email</label>
					<input type="email" id="email" name="email" required placeholder="your.email@example.com">
				</div>
				<div class="form-group">
					<label for="message">Message</label>
					<textarea id="message" name="message" rows="6" required placeholder="Share your thoughts..."></textarea>
				</div>
				<button type="submit" class="btn btn-primary">
					Send Message ✉️
				</button>
			</form>
		</div>
	</div>
</section>

<style>
	.contact {
		padding: 6rem 2rem 8rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 1rem;
		background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.section-subtitle {
		text-align: center;
		font-size: 1.1rem;
		color: var(--text-muted);
		margin-bottom: 3rem;
		font-family: system-ui, -apple-system, sans-serif;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		margin-bottom: 4rem;
	}

	.contact-card {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 16px;
		padding: 1.5rem;
		box-shadow: 
			0 0 25px color-mix(in srgb, var(--card-color) 20%, transparent),
			0 8px 30px rgba(0, 0, 0, 0.5),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid color-mix(in srgb, var(--card-color) 30%, transparent);
		transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
		position: relative;
		overflow: hidden;
		transform-style: preserve-3d;
		will-change: transform;
	}

	.contact-card::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, var(--card-color), transparent 70%);
		opacity: 0;
		transform: translate(-50%, -50%);
		transition: opacity 0.6s ease;
		pointer-events: none;
	}

	.contact-card:hover {
		box-shadow: 
			0 0 40px color-mix(in srgb, var(--card-color) 40%, transparent),
			0 12px 40px rgba(0, 0, 0, 0.6),
			inset 0 0 60px rgba(255, 255, 255, 0.1);
		border-color: var(--card-color);
		background: color-mix(in srgb, var(--card-bg) 90%, var(--card-color) 10%);
	}

	.contact-card:hover::after {
		opacity: 0.15;
	}

	.contact-icon {
		font-size: 2.5rem;
		filter: drop-shadow(0 0 15px var(--card-color));
	}

	.contact-content {
		width: 100%;
	}

	.contact-label {
		font-size: 1.1rem;
		color: var(--card-color);
		margin: 0 0 0.5rem 0;
		font-weight: 600;
	}

	.contact-value {
		font-size: 0.9rem;
		color: var(--text-color);
		margin: 0;
		word-break: break-word;
	}

	.form-container {
		background: var(--card-bg);
		backdrop-filter: blur(25px) saturate(180%);
		-webkit-backdrop-filter: blur(25px) saturate(180%);
		border-radius: 20px;
		padding: 2.5rem;
		box-shadow: 
			0 0 30px rgba(var(--secondary-rgb), 0.2),
			0 10px 40px rgba(0, 0, 0, 0.5),
			inset 0 0 40px rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(var(--secondary-rgb), 0.3);
		position: relative;
		overflow: hidden;
		transform-style: preserve-3d;
		will-change: transform;
	}

	.form-container::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 300px;
		height: 300px;
		background: radial-gradient(circle, var(--secondary-color), transparent 70%);
		opacity: 0;
		transform: translate(-50%, -50%);
		transition: opacity 0.6s ease;
		pointer-events: none;
	}

	.form-container:hover::after {
		opacity: 0.15;
	}

	.form-title {
		font-size: 1.75rem;
		color: var(--secondary-color);
		margin: 0 0 2rem 0;
		text-align: center;
		font-weight: 600;
	}

	.contact-form {
		font-family: system-ui, -apple-system, sans-serif;
	}

	.form-group {
		margin-bottom: 1.5rem;
	}

	.form-group label {
		display: block;
		color: var(--text-color);
		margin-bottom: 0.5rem;
		font-weight: 600;
		font-size: 0.95rem;
	}

	.form-group input,
	.form-group textarea {
		width: 100%;
		padding: 0.875rem;
		background: color-mix(in srgb, var(--card-bg) 92%, var(--bg-color) 8%);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 2px solid rgba(var(--secondary-rgb), 0.3);
		border-radius: 12px;
		color: var(--text-color);
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 1rem;
		transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--secondary-color);
		box-shadow: 0 0 20px rgba(var(--secondary-rgb), 0.4);
		transform: translateY(-2px);
		background: color-mix(in srgb, var(--card-bg) 90%, rgba(var(--secondary-rgb), 0.12) 10%);
	}

	.form-group textarea {
		resize: vertical;
		min-height: 150px;
	}

	.contact-form button {
		width: 100%;
		margin-top: 1rem;
		padding: 1rem;
		font-size: 1.1rem;
		font-weight: 600;
		background: linear-gradient(135deg, var(--secondary-color), var(--primary-color));
		border: none;
		border-radius: 12px;
		color: var(--bg-color);
		cursor: pointer;
		transition: all 0.3s ease;
		box-shadow: 0 0 30px rgba(var(--secondary-rgb), 0.4);
	}

	.contact-form button:hover {
		box-shadow: 0 0 50px rgba(var(--secondary-rgb), 0.6);
	}

	@media (max-width: 768px) {
		.contact {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.contact-grid {
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		}

		.form-container {
			padding: 1.5rem;
		}

		.form-title {
			font-size: 1.5rem;
		}
	}
</style>

<script>
	import { init3DCardEffect } from '../utils/card3d';
	init3DCardEffect('.contact-card, .form-container', 15);
</script>
