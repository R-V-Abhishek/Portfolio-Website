---
const contactInfo = [
	{ icon: "📧", label: "Email", value: "rvabhi2504@gmail.com", link: "mailto:rvabhi2504@gmail.com", color: "var(--primary-color)" },
	{ icon: "💼", label: "LinkedIn", value: "r-v-abhishek", link: "https://www.linkedin.com/in/r-v-abhishek", color: "var(--secondary-color)" },
	{ icon: "💻", label: "GitHub", value: "R-V-Abhishek", link: "https://github.com/R-V-Abhishek", color: "var(--primary-light)" },
	{ icon: "📱", label: "Phone", value: "+91 83299 65881", link: "tel:+918329965881", color: "var(--accent-color)" }
];
---

<section id="contact" class="contact fade-in">
	<div class="container">
		<div class="section-eyebrow">[ Contact ]</div>
		<h2 class="section-title">Get In Touch</h2>
		<p class="section-subtitle">Let's collaborate and create something amazing together!</p>

		<div class="contact-grid">
			{contactInfo.map((info) => (
				<a href={info.link} target="_blank" rel="noopener noreferrer" class="contact-card hoverable-card" style={`--card-color: ${info.color}; --flood-color: ${info.color};`}>
					<div class="contact-icon">{info.icon}</div>
					<div class="contact-content">
						<h3 class="contact-label">{info.label}</h3>
						<p class="contact-value">{info.value}</p>
					</div>
				</a>
			))}
		</div>

		<div class="form-container">
			<h3 class="form-title">Send a Message</h3>
			<form action="https://formspree.io/f/your-form-id" method="POST" class="contact-form">
				<div class="form-group">
					<label for="name">Name</label>
					<input type="text" id="name" name="name" required placeholder="Your name">
				</div>
				<div class="form-group">
					<label for="email">Email</label>
					<input type="email" id="email" name="email" required placeholder="your.email@example.com">
				</div>
				<div class="form-group">
					<label for="message">Message</label>
					<textarea id="message" name="message" rows="6" required placeholder="Share your thoughts..."></textarea>
				</div>
				<button type="submit" class="btn btn-primary">
					Send Message ✉️
				</button>
			</form>
		</div>
	</div>
</section>

<style>
	.contact {
		padding: 6rem 2rem 8rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
	}

	.section-eyebrow {
		text-align: center;
		margin-bottom: 0.75rem;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 1rem;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.section-subtitle {
		text-align: center;
		font-size: 1.1rem;
		color: var(--text-muted);
		margin-bottom: 3rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		margin-bottom: 4rem;
	}

	.contact-card {
		background: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 16px;
		padding: 1.5rem;
		box-shadow:
			0 0 20px color-mix(in srgb, var(--card-color) 15%, transparent),
			0 8px 30px rgba(0, 0, 0, 0.4);
		border: 2px solid color-mix(in srgb, var(--card-color) 30%, transparent);
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.75rem;
	}

	.contact-icon {
		font-size: 2.5rem;
		filter: drop-shadow(0 0 12px var(--card-color));
		position: relative;
		z-index: 1;
	}

	.contact-content {
		width: 100%;
		position: relative;
		z-index: 1;
	}

	.contact-label {
		font-size: 1.1rem;
		color: var(--card-color);
		margin: 0 0 0.5rem 0;
		font-weight: 600;
		font-family: 'JetBrains Mono', monospace;
	}

	.contact-value {
		font-size: 0.9rem;
		color: var(--text-color);
		margin: 0;
		word-break: break-word;
	}

	/* Override label color on hover (flood fills card) */
	.contact-card:hover .contact-label {
		color: #07071a;
	}

	.form-container {
		background: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 20px;
		padding: 2.5rem;
		box-shadow:
			0 0 30px rgba(var(--secondary-rgb), 0.15),
			0 10px 40px rgba(0, 0, 0, 0.4);
		border: 2px solid rgba(var(--secondary-rgb), 0.25);
	}

	.form-title {
		font-size: 1.75rem;
		color: var(--secondary-color);
		margin: 0 0 2rem 0;
		text-align: center;
		font-weight: 600;
		font-family: 'JetBrains Mono', monospace;
	}

	.form-group {
		margin-bottom: 1.5rem;
	}

	.form-group label {
		display: block;
		color: var(--text-color);
		margin-bottom: 0.5rem;
		font-weight: 600;
		font-size: 0.95rem;
		font-family: 'JetBrains Mono', monospace;
	}

	.form-group input,
	.form-group textarea {
		width: 100%;
		padding: 0.875rem;
		background: rgba(7, 7, 26, 0.6);
		border: 2px solid rgba(var(--secondary-rgb), 0.25);
		border-radius: 12px;
		color: var(--text-color);
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 1rem;
		transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
		box-sizing: border-box;
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--secondary-color);
		box-shadow: 0 0 20px rgba(var(--secondary-rgb), 0.35);
		transform: translateY(-2px);
	}

	.form-group textarea {
		resize: vertical;
		min-height: 150px;
	}

	.contact-form button {
		width: 100%;
		margin-top: 1rem;
		padding: 1rem;
		font-size: 1.1rem;
	}

	@media (max-width: 768px) {
		.contact {
			padding: 4rem 1.5rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.contact-grid {
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		}

		.form-container {
			padding: 1.5rem;
		}

		.form-title {
			font-size: 1.5rem;
		}
	}
</style>
