---
const projects = [
	{
		title: "SaffronSpice",
		description: "A full-stack restaurant management application built with the MERN stack, featuring user authentication, reservations, cart functionality, and a complete ordering system.",
		tech: ["React", "Node.js", "Express", "MongoDB", "REST APIs"],
		liveLink: "https://saffron-spice-restaurant-git-main-r-v-abhisheks-projects.vercel.app/",
		githubLink: "https://github.com/R-V-Abhishek/SaffronSpice",
		status: "deployed",
		featured: true
	},
	{
		title: "GST Automation",
		description: "Python automation toolkit for processing GST reports from Tally ERP exports with interactive directory selection, multi-rate GST handling, and B2B/B2C classification.",
		tech: ["Python", "Pandas", "Data Processing", "Automation"],
		githubLink: "https://github.com/R-V-Abhishek/GST-Automation",
		status: "completed",
		featured: true
	},
	{
		title: "EigenLayer Restaking API",
		description: "Backend API service that simulates/exposes restaking data related to EigenLayer protocol, providing endpoints for validator info, delegations, and aggregated rewards.",
		tech: ["Node.js", "Express", "REST APIs", "Blockchain"],
		githubLink: "https://github.com/R-V-Abhishek/eigen-restaking-api",
		status: "completed",
		featured: true
	},
	{
		title: "Titanic Dataset EDA",
		description: "Comprehensive exploratory data analysis of the classic Titanic dataset, featuring data cleaning, visualization, and survival factor analysis using Python and statistical methods.",
		tech: ["Python", "Pandas", "Seaborn", "Matplotlib", "Data Analysis"],
		githubLink: "https://github.com/R-V-Abhishek/Titanic-Dataset-EDA",
		status: "completed",
		featured: false
	}
];

const projectColors = [
	'var(--accent-color)',
	'var(--secondary-color)',
	'var(--primary-color)',
	'var(--highlight-color)'
];
---

<section id="projects" class="projects fade-in">
	<div class="container">
		<div class="terminal-header-section">
			<span class="prompt">guest@portfolio</span>:<span class="path">~</span><span class="symbol">$</span> ls -la projects/
		</div>
		<div class="projects-grid">
			{projects.map((project, index) => (
				<div
					class={`project-card hoverable-card ${project.featured ? 'featured' : ''}`}
					style={`--flood-color: ${projectColors[index % projectColors.length]};`}
				>
					<div class="card-header">
						<span class="file-icon">📁</span>
						<span class="status-badge" data-status={project.status}>[{project.status}]</span>
					</div>
					<h3 class="project-title">&gt; {project.title}</h3>
					<p class="project-description">{project.description}</p>
					<div class="project-tech">
						<span class="tech-label">// Tech Stack:</span>
						<div class="tech-list">
							{project.tech.map(tech => (
								<span class="tech-badge">• {tech}</span>
							))}
						</div>
					</div>
					<div class="project-links">
						{project.githubLink && (
							<a href={project.githubLink} target="_blank" rel="noopener noreferrer" class="project-link">
								[ GitHub ]
							</a>
						)}
						{project.liveLink && (
							<a href={project.liveLink} target="_blank" rel="noopener noreferrer" class="project-link live">
								[ Live Demo ]
							</a>
						)}
					</div>
				</div>
			))}
		</div>
		<div class="terminal-footer-section">
			<span class="status-ok">[✓]</span> {projects.length} projects found
		</div>
		<div class="view-more">
			<a href="https://github.com/R-V-Abhishek" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
				&gt; View All on GitHub
			</a>
		</div>
	</div>
</section>

<style>
	.projects {
		padding: 6rem 2rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.terminal-header-section {
		background: linear-gradient(to bottom, var(--terminal-bg-start), var(--terminal-bg-end));
		padding: 0.75rem 1.5rem;
		border: 2px solid var(--accent-color);
		border-radius: 8px 8px 0 0;
		box-shadow: 0 2px 10px rgba(var(--accent-rgb), 0.2);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.9rem;
		color: var(--text-light);
		margin-bottom: 2rem;
	}

	.prompt {
		color: var(--prompt-user);
		font-weight: 600;
	}

	.path {
		color: var(--prompt-path);
	}

	.symbol {
		color: var(--prompt-symbol);
		margin: 0 0.5rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.project-card {
		background: color-mix(in srgb, var(--card-bg) 92%, var(--bg-color) 8%);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 2px solid var(--accent-color);
		border-radius: 16px;
		padding: 1.5rem;
		transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		box-shadow:
			0 0 20px rgba(var(--accent-rgb), 0.2),
			0 8px 32px rgba(0, 0, 0, 0.6);
		position: relative;
		overflow: hidden;
	}

	.project-card.featured {
		border-color: var(--primary-color);
		background: color-mix(in srgb, var(--card-bg) 84%, rgba(var(--primary-rgb), 0.22) 16%);
		box-shadow:
			0 0 30px rgba(var(--primary-rgb), 0.4),
			0 8px 32px rgba(0, 0, 0, 0.6);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		font-size: 1.2rem;
	}

	.file-icon {
		filter: drop-shadow(0 0 5px var(--accent-color));
	}

	.status-badge {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		color: var(--primary-color);
		text-transform: uppercase;
		font-weight: 600;
	}

	.status-badge[data-status="deployed"] {
		color: var(--primary-color);
		text-shadow: var(--glow-green);
	}

	.status-badge[data-status="completed"] {
		color: var(--secondary-color);
	}

	.project-title {
		font-size: 1.4rem;
		color: var(--accent-color);
		margin: 0 0 1rem 0;
		font-weight: 700;
		font-family: 'JetBrains Mono', monospace;
		text-shadow: 0 0 10px rgba(var(--accent-rgb), 0.3);
	}

	.project-description {
		color: var(--text-light);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		font-size: 0.95rem;
	}

	.project-tech {
		margin-bottom: 1.5rem;
	}

	.tech-label {
		color: var(--text-muted);
		font-size: 0.85rem;
		display: block;
		margin-bottom: 0.5rem;
		font-style: italic;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tech-badge {
		color: var(--secondary-color);
		font-size: 0.85rem;
		font-family: 'JetBrains Mono', monospace;
		background: rgba(var(--secondary-rgb), 0.1);
		padding: 0.25rem 0.75rem;
		border-radius: 4px;
		border: 1px solid rgba(var(--secondary-rgb), 0.3);
		transition: all 0.3s ease;
	}

	.tech-badge:hover {
		background: rgba(var(--secondary-rgb), 0.2);
		border-color: var(--secondary-color);
		box-shadow: 0 0 15px rgba(var(--secondary-rgb), 0.4);
	}

	.project-links {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.project-link {
		color: var(--primary-color);
		text-decoration: none;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.9rem;
		border: 1px solid var(--primary-color);
		padding: 0.4rem 1rem;
		border-radius: 4px;
		background: rgba(var(--primary-rgb), 0.05);
		transition: all 0.3s ease;
		font-weight: 600;
	}

	.project-link:hover {
		background: var(--primary-color);
		color: var(--bg-color);
		box-shadow: 0 0 25px rgba(var(--primary-rgb), 0.6);
	}

	.project-link.live {
		color: var(--accent-color);
		border-color: var(--accent-color);
		background: rgba(var(--accent-rgb), 0.05);
	}

	.project-link.live:hover {
		background: var(--accent-color);
		color: var(--bg-color);
		box-shadow: 0 0 25px rgba(var(--accent-rgb), 0.6);
	}

	.terminal-footer-section {
		background: linear-gradient(to bottom, var(--terminal-bg-end), var(--terminal-bg-start));
		padding: 0.75rem 1.5rem;
		border: 2px solid var(--accent-color);
		border-radius: 0 0 8px 8px;
		box-shadow: 0 -2px 10px rgba(var(--accent-rgb), 0.2);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.9rem;
		color: var(--text-light);
		margin-bottom: 2rem;
	}

	.status-ok {
		color: var(--primary-color);
		font-weight: 600;
		text-shadow: var(--glow-green);
	}

	.view-more {
		text-align: center;
		margin-top: 3rem;
	}

	@media (max-width: 768px) {
		.projects {
			padding: 4rem 1.5rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.project-card {
			padding: 1.25rem;
		}

		.project-title {
			font-size: 1.2rem;
		}
	}
</style>

<script>
	import { init3DCardEffect } from '../utils/card3d';
	init3DCardEffect('.project-card', 10);
</script>
