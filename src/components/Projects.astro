---
import type { Project } from '../data/projects.js';
import { projects } from '../data/projects.js';

interface Props {
	showFilter?: boolean;
	limit?: number;
}

const { showFilter = false, limit } = Astro.props;

const displayProjects = limit ? projects.slice(0, limit) : projects;
---

<section id="projects" class="projects fade-in">
	<div class="container">
		<div class="section-eyebrow">[ My Work ]</div>
		<h2 class="section-title">Projects</h2>

		{showFilter && (
			<div class="filter-bar" id="filter-bar">
				<button class="filter-btn active" data-filter="all">All</button>
				<button class="filter-btn" data-filter="full-stack">Full Stack</button>
				<button class="filter-btn" data-filter="data-science">Data Science</button>
				<button class="filter-btn" data-filter="backend">Backend</button>
			</div>
		)}

		<div class="projects-grid" id="projects-grid">
			{displayProjects.map((project) => (
				<div
					class={`project-card hoverable-card ${project.featured ? 'featured' : ''}`}
					data-category={project.category}
					style="--flood-color: var(--primary-color);"
				>
					<div class="card-header">
						<span class="file-icon">📁</span>
						<span class="status-badge" data-status={project.status}>[{project.status}]</span>
					</div>
					<h3 class="project-title">{project.title}</h3>
					<p class="project-description">{project.description}</p>
					<div class="project-tech">
						<span class="tech-label">Tech Stack</span>
						<div class="tech-list">
							{project.tech.map(tech => (
								<span class="tech-badge">{tech}</span>
							))}
						</div>
					</div>
					<div class="project-links">
						{project.githubLink && (
							<a href={project.githubLink} target="_blank" rel="noopener noreferrer" class="project-link">
								GitHub
							</a>
						)}
						{project.liveLink && (
							<a href={project.liveLink} target="_blank" rel="noopener noreferrer" class="project-link live">
								Live Demo
							</a>
						)}
					</div>
				</div>
			))}
		</div>

		<div class="view-more">
			<a href="https://github.com/R-V-Abhishek" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
				View All on GitHub
			</a>
		</div>
	</div>
</section>

{showFilter && (
	<script is:inline>
		const filterBar = document.getElementById('filter-bar');
		const grid = document.getElementById('projects-grid');

		filterBar?.addEventListener('click', (e) => {
			const btn = e.target.closest('.filter-btn');
			if (!btn) return;

			filterBar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
			btn.classList.add('active');

			const filter = btn.dataset.filter;
			grid?.querySelectorAll('.project-card').forEach(card => {
				const match = filter === 'all' || card.dataset.category === filter;
				card.style.opacity = match ? '1' : '0.2';
				card.style.transform = match ? '' : 'scale(0.97)';
				card.style.pointerEvents = match ? '' : 'none';
			});
		});
	</script>
)}

<style>
	.projects {
		padding: 6rem 2rem;
		background: var(--bg-color);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 1rem;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.section-eyebrow {
		text-align: center;
		margin-bottom: 0.75rem;
	}

	/* Filter bar */
	.filter-bar {
		display: flex;
		gap: 0.75rem;
		justify-content: center;
		flex-wrap: wrap;
		margin: 2rem 0 2.5rem;
	}

	.filter-btn {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.5rem 1.25rem;
		border-radius: 6px;
		background: rgba(var(--primary-rgb), 0.08);
		border: 1px solid rgba(var(--primary-rgb), 0.25);
		color: var(--text-light);
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.filter-btn:hover {
		border-color: var(--primary-color);
		color: var(--primary-light);
	}

	.filter-btn.active {
		background: var(--primary-color);
		border-color: var(--primary-color);
		color: #07071a;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.project-card {
		background: var(--card-bg);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 2px solid rgba(var(--primary-rgb), 0.25);
		border-radius: 16px;
		padding: 1.5rem;
		box-shadow: var(--shadow-card);
	}

	.project-card.featured {
		border-color: rgba(var(--primary-rgb), 0.5);
		box-shadow: 0 0 30px rgba(var(--primary-rgb), 0.2), var(--shadow-card);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		font-size: 1.2rem;
	}

	.status-badge {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--success-color);
	}

	.status-badge[data-status="completed"] {
		color: var(--secondary-color);
	}

	.project-title {
		font-size: 1.35rem;
		color: var(--primary-light);
		margin: 0 0 1rem 0;
		font-weight: 700;
		font-family: 'JetBrains Mono', monospace;
		text-shadow: 0 0 10px rgba(var(--primary-rgb), 0.3);
	}

	.project-description {
		color: var(--text-light);
		line-height: 1.7;
		margin-bottom: 1.5rem;
		font-size: 0.95rem;
	}

	.project-tech {
		margin-bottom: 1.5rem;
	}

	.tech-label {
		color: var(--text-muted);
		font-size: 0.8rem;
		font-family: 'JetBrains Mono', monospace;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		display: block;
		margin-bottom: 0.6rem;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tech-badge {
		color: var(--secondary-color);
		font-size: 0.82rem;
		font-family: 'JetBrains Mono', monospace;
		background: rgba(var(--secondary-rgb), 0.1);
		padding: 0.25rem 0.65rem;
		border-radius: 4px;
		border: 1px solid rgba(var(--secondary-rgb), 0.25);
		transition: all 0.25s ease;
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.project-link {
		color: var(--primary-color);
		text-decoration: none;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.88rem;
		border: 1px solid rgba(var(--primary-rgb), 0.4);
		padding: 0.4rem 1rem;
		border-radius: 6px;
		background: rgba(var(--primary-rgb), 0.06);
		transition: all 0.25s ease;
		font-weight: 600;
	}

	.project-link:hover {
		background: rgba(var(--primary-rgb), 0.15);
		border-color: var(--primary-color);
		box-shadow: var(--glow-primary);
		transform: translateY(-2px);
		text-shadow: none;
	}

	.project-link.live {
		color: var(--accent-color);
		border-color: rgba(var(--accent-rgb), 0.4);
		background: rgba(var(--accent-rgb), 0.06);
	}

	.project-link.live:hover {
		background: rgba(var(--accent-rgb), 0.15);
		border-color: var(--accent-color);
		box-shadow: var(--glow-pink);
	}

	.view-more {
		text-align: center;
		margin-top: 3rem;
	}

	@media (max-width: 768px) {
		.projects {
			padding: 4rem 1.5rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.project-card {
			padding: 1.25rem;
		}

		.project-title {
			font-size: 1.2rem;
		}
	}
</style>
