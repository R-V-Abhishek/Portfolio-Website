---
interface Props {
	opacity?: number;
}

const { opacity = 0.08 } = Astro.props;
---

<canvas id="matrix-canvas" class="matrix-rain" style={`--matrix-opacity: ${opacity};`}></canvas>

<style>
	#matrix-canvas {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
		opacity: var(--matrix-opacity, 0.08);
		background: transparent;
		pointer-events: none;
		mix-blend-mode: screen;
		transition: opacity 0.5s ease;
	}
</style>

<script is:inline>
	(function() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		const canvas = document.getElementById('matrix-canvas');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;

		const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%^&*()_+-=[]{}|;:,.<>?/~`';
		const charArray = chars.split('');
		
		const fontSize = 16;
		let columns = Math.floor(canvas.width / fontSize);
		
		const drops = [];
		const speeds = [];
		
		function seedDrops() {
			columns = Math.floor(canvas.width / fontSize);
			drops.length = 0;
			speeds.length = 0;
			for (let i = 0; i < columns; i++) {
				drops[i] = Math.floor(Math.random() * (canvas.height / fontSize));
				speeds[i] = Math.random() * 0.23 + 0.12;
			}
		}

		seedDrops();

		function getThemeColors() {
			const theme = document.documentElement.getAttribute('data-theme') || 'dark';
			if (theme === 'light') {
				return {
					fade: 'rgba(255, 255, 255, 0.06)',
					color: { r: 0, g: 180, b: 50 } // Darker green for light theme
				};
			} else {
				return {
					fade: 'rgba(0, 0, 0, 0.05)',
					color: { r: 0, g: 255, b: 65 } // Bright green for dark theme
				};
			}
		}

		function draw() {
			const colors = getThemeColors();
			ctx.fillStyle = colors.fade;
			ctx.fillRect(0, 0, canvas.width, canvas.height);
			
			for (let i = 0; i < drops.length; i++) {
				const brightness = Math.random() * 0.3 + 0.7;
				const c = colors.color;
				ctx.fillStyle = `rgba(${c.r}, ${c.g}, ${c.b}, ${brightness})`;
				ctx.font = fontSize + 'px monospace';
				
				const text = charArray[Math.floor(Math.random() * charArray.length)];
				ctx.fillText(text, i * fontSize, drops[i] * fontSize);
				
				if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
					drops[i] = 0;
				}
				
				drops[i] += speeds[i];
			}
		}

		let paused = document.hidden;

		function animate() {
			if (paused) return;
			draw();
			requestAnimationFrame(animate);
		}

		function onVisibilityChange() {
			paused = document.hidden;
			if (!paused) {
				requestAnimationFrame(animate);
			}
		}

		document.addEventListener('visibilitychange', onVisibilityChange);
		if (!paused) {
			animate();
		}

		window.addEventListener('resize', function() {
			canvas.width = window.innerWidth;
			canvas.height = window.innerHeight;
			seedDrops();
		});
	})();
</script>
