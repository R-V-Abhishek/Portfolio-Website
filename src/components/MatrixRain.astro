---
interface Props {
	opacity?: number;
}
const { opacity = 0.15 } = Astro.props;
---

<canvas id="matrix-canvas" class="matrix-rain" style={`opacity: ${opacity}`}></canvas>

<style>
	#matrix-canvas {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		background: transparent;
		pointer-events: none;
		mix-blend-mode: screen;
		transition: opacity 0.5s ease;
	}
</style>

<script is:inline>
	(function() {
		const canvas = document.getElementById('matrix-canvas');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		canvas.width = window.innerWidth;
		canvas.height = window.innerHeight;

		const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%^&*()_+-=[]{}|;:,.<>?/~`';
		const charArray = chars.split('');

		const fontSize = 16;
		let columns = Math.floor(canvas.width / fontSize);

		const drops = [];
		const speeds = [];

		function seedDrops() {
			columns = Math.floor(canvas.width / fontSize);
			drops.length = 0;
			speeds.length = 0;
			for (let i = 0; i < columns; i++) {
				drops[i] = Math.floor(Math.random() * (canvas.height / fontSize));
				speeds[i] = Math.random() * 0.5 + 0.5;
			}
		}

		seedDrops();

		function draw() {
			// Use new dark navy background color for trail fade
			ctx.fillStyle = 'rgba(7, 7, 26, 0.1)';
			ctx.fillRect(0, 0, canvas.width, canvas.height);

			for (let i = 0; i < drops.length; i++) {
				// Low brightness range — subtle texture, not dominant
				const brightness = Math.random() * 0.3 + 0.2;
				// Alternate between purple and cyan for new palette
				const isPurple = Math.random() > 0.4;
				ctx.fillStyle = isPurple
					? `rgba(167, 139, 250, ${brightness * 0.8})`
					: `rgba(34, 211, 238, ${brightness * 0.5})`;
				ctx.font = fontSize + 'px monospace';

				const text = charArray[Math.floor(Math.random() * charArray.length)];
				ctx.fillText(text, i * fontSize, drops[i] * fontSize);

				if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
					drops[i] = 0;
				}

				drops[i] += speeds[i];
			}
		}

		function animate() {
			draw();
			requestAnimationFrame(animate);
		}
		animate();

		window.addEventListener('resize', function() {
			canvas.width = window.innerWidth;
			canvas.height = window.innerHeight;
			seedDrops();
		});
	})();
</script>
